{
  "type": "object",
  "properties": {
    "vault": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "format": "directory",
          "description": "Obsidian/PKOS vault root — base for recall and the directory contract (<root>/99-System/10-Directory-Contract.md). Optional: when unset, recall falls back to subjective_dir."
        },
        "subjective_dir": {
          "type": "string",
          "format": "directory",
          "description": "Your subjective notes / journal directory"
        },
        "news_dir": {
          "type": "string",
          "format": "directory",
          "description": "News / domain feed inputs directory"
        },
        "output_dir": {
          "type": "string",
          "format": "directory",
          "description": "Generated briefs and topic log live here"
        }
      },
      "required": [
        "subjective_dir",
        "news_dir",
        "output_dir"
      ]
    },
    "tts": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "volc",
            "minimax"
          ],
          "description": "TTS provider: volc (Volcengine / Doubao) or minimax (MiniMax)"
        },
        "host_voice": {
          "type": "string",
          "x-dynamic-from": "tts.provider",
          "description": "Host voice id — must match the selected provider's voice catalog"
        }
      },
      "required": [
        "provider",
        "host_voice"
      ]
    },
    "podcast": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Required project/channel name when creating a podcast project."
        },
        "english_name": {
          "type": "string",
          "minLength": 1,
          "description": "Optional English display name for bilingual production; original name/history are retained."
        }
      },
      "required": [
        "name"
      ]
    },
    "production": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "claude",
            "openai"
          ],
          "description": "Service used by the existing morning/evening orchestrator."
        },
        "language": {
          "type": "string",
          "enum": [
            "zh",
            "en"
          ]
        },
        "model": {
          "type": "string",
          "enum": [
            "gpt-4.1-mini-2025-04-14"
          ]
        },
        "speech_model": {
          "type": "string",
          "enum": [
            "gpt-realtime-2.1-mini"
          ]
        },
        "voice": {
          "type": "string",
          "enum": [
            "alloy",
            "ash",
            "ballad",
            "coral",
            "echo",
            "sage",
            "shimmer",
            "verse",
            "marin",
            "cedar"
          ]
        },
        "source_authorized": {
          "type": "boolean",
          "default": false,
          "description": "Record the owner’s approval for selected configured sources to be processed by OpenAI; never inferred by installation."
        },
        "budget_ledger": {
          "type": "string",
          "description": "Existing shared ledger with verified actual commitments; not auto-created/reset."
        },
        "budget_timezone": {
          "type": "string"
        },
        "per_call_limit_usd": {
          "type": "number",
          "minimum": 0
        },
        "daily_limit_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32768
        },
        "speech_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 1536
        },
        "source_mode": {
          "type": "string",
          "enum": [
            "legacy",
            "public"
          ],
          "description": "Public selects exact manifested news/archive files; legacy preserves the original private viewpoint workflow."
        },
        "source_manifest": {
          "type": "string",
          "description": "Existing exact public source manifest path; no whole-vault scope."
        },
        "min_words": {
          "type": "integer",
          "minimum": 300
        },
        "target_words": {
          "type": "integer",
          "minimum": 300
        },
        "max_words": {
          "type": "integer",
          "minimum": 300
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Pins the exact reviewed public-source manifest; changing scope requires updating this configuration."
        },
        "min_minutes": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 90
        },
        "target_minutes": {
          "type": "integer",
          "default": 25,
          "minimum": 1,
          "maximum": 90
        },
        "max_minutes": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 90
        },
        "speaking_rate_wpm": {
          "type": "integer",
          "default": 130,
          "minimum": 100,
          "maximum": 160
        },
        "max_average_sentence_words": {
          "type": "integer",
          "default": 18,
          "minimum": 10,
          "maximum": 22
        },
        "max_sentence_words": {
          "type": "integer",
          "default": 32,
          "minimum": 10,
          "maximum": 45
        },
        "episode_kind": {
          "type": "string",
          "enum": [
            "full",
            "demo"
          ],
          "default": "full",
          "description": "Full episodes use the configured 20–30 minute range. Demo explicitly allows short technical tests."
        },
        "listening_level": {
          "type": "string",
          "enum": [
            "b1-b2"
          ],
          "default": "b1-b2",
          "description": "Listening-language target, not a proficiency certification; retain facts, caveats and substantive detail."
        }
      }
    }
  },
  "required": [],
  "allOf": [
    {
      "if": {
        "properties": {
          "production": {
            "properties": {
              "provider": {
                "const": "openai"
              }
            },
            "required": [
              "provider"
            ]
          }
        },
        "required": [
          "production"
        ]
      },
      "then": {
        "required": [
          "podcast"
        ]
      }
    }
  ]
}
